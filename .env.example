# Copy to backend/.env and adjust as needed
THERMOSOLVE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
THERMOSOLVE_MAX_NODES=2000
THERMOSOLVE_MAX_TIME_STEPS=20000
THERMOSOLVE_MAX_NODE_STEPS=20000000
# Store every intermediate augmented matrix when N <= RECORD_LIMIT
THERMOSOLVE_RECORD_LIMIT=12
# Send the dense matrix to the UI when N <= MATRIX_PAYLOAD_LIMIT
THERMOSOLVE_MATRIX_PAYLOAD_LIMIT=100
